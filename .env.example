# ===============================================
# Ryuuzaa MD - Environment Variables (Optional)
# ===============================================
# Cara pakai:
#   1. Copy file ini menjadi .env  (cp .env.example .env)
#   2. Isi value yang dibutuhkan
#   3. File .env TIDAK akan ke-commit (sudah di .gitignore)
#
# Semua env var di sini OPSIONAL.
# Bot tetap bisa jalan dengan default dari config.js.
# ===============================================

# --- Override Bot Identity (opsional) ---
# Kalau diisi, akan override config.js
# BOT_NUMBER=6289520307004
# OWNER_NUMBER=6289517185039
# CUSTOM_PAIRING_CODE=RYUUZAAA

# --- Login Method Override ---
# 'pairing' atau 'qr'
# LOGIN_METHOD=pairing

# --- API Keys (untuk fitur AI/external API di masa depan) ---
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# REMOVEBG_API_KEY=

# --- Logger ---
# 'fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace' | 'silent'
# LOG_LEVEL=info
